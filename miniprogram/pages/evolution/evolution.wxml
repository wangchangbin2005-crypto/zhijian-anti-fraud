<view class="af-page">
  <view class="af-page-header-title">知识库进化状态</view>
  <view class="af-page-header-sub">自动采集为静态模拟</view>
  <view class="af-stat-grid">
    <view class="af-stat"><text class="af-stat-value" style="color:#3b82f6">{{status.total_runs||0}}</text><text class="af-stat-label">累计进化</text></view>
    <view class="af-stat"><text class="af-stat-value" style="color:#10b981">{{cases.length}}</text><text class="af-stat-label">总案例</text></view>
    <view class="af-stat"><text class="af-stat-value" style="color:#f59e0b">{{status.interval_hours||6}}h</text><text class="af-stat-label">更新间隔</text></view>
    <view class="af-stat"><text class="af-stat-value small">{{status.last_run||'未运行'}}</text><text class="af-stat-label">最近运行</text></view>
  </view>
  <view class="af-card">
    <button class="af-btn-primary full" loading="{{loading}}" bindtap="run">立即进化</button>
    <button class="af-btn-outline full mt" bindtap="reload">刷新</button>
    <view class="af-card-title" style="margin-top:24rpx">最近日志</view>
    <view wx:if="{{!status.recent_logs||!status.recent_logs.length}}" class="empty">暂无，点击立即进化</view>
    <view wx:for="{{status.recent_logs}}" wx:key="run_at" class="log">
      <text class="t">{{item.run_at}}</text>
      <text class="d">采集 {{item.raw_fetched}} · 新增 +{{item.added}} · 跳过 {{item.skipped}} · {{item.duration_seconds}}s</text>
    </view>
  </view>
  <view class="af-card">
    <view class="af-card-title">类型分布</view>
    <view wx:for="{{typeStats}}" wx:key="type" class="row">
      <text>{{item.type}}</text>
      <text class="n">{{item.count}}</text>
    </view>
  </view>
  <view class="af-card">
    <view class="af-card-title">案例预览（前40条）</view>
    <view wx:for="{{cases}}" wx:key="id" wx:for-index="i" class="ci" wx:if="{{i<40}}">
      <text class="tp">{{item.type}}</text>
      <text>{{item.summary}}</text>
    </view>
  </view>
</view>
