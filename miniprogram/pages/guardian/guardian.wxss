page {
  background: #f0f0fa;
  min-height: 100vh;
}

.page {
  padding: 32rpx 28rpx;
  box-sizing: border-box;
}

.section-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1a2340;
  margin-bottom: 8rpx;
}

.section-sub {
  font-size: 24rpx;
  color: #8a9bbf;
  margin-bottom: 24rpx;
}

.owner-tag {
  display: inline-block;
  padding: 10rpx 24rpx;
  background: #e8eeff;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #4a6cf7;
  margin-bottom: 24rpx;
}

.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 16rpx rgba(0,0,0,0.06);
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a2340;
  margin-bottom: 24rpx;
}

.input {
  width: 100%;
  height: 88rpx;
  background: #f4f6fb;
  border-radius: 14rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #1a2340;
  box-sizing: border-box;
  margin-bottom: 16rpx;
  border: 1.5rpx solid #e8eaf2;
}

.picker-wrap {
  margin-bottom: 16rpx;
}

.picker-text {
  color: #1a2340;
  line-height: 88rpx;
}

.label {
  font-size: 24rpx;
  color: #8a9bbf;
  margin-bottom: 12rpx;
}

.chips {
  display: flex;
  flex-direction: row;
  gap: 12rpx;
  margin-bottom: 28rpx;
}

.chip {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 14rpx;
  border: 1.5rpx solid #dde2f0 !important;
  font-size: 26rpx;
  color: #8a9bbf !important;
  background: #f4f6fb !important;
  margin: 0;
  padding: 0;
  text-align: center;
  font-weight: 400;
}

.chip.on {
  border-color: #4a6cf7 !important;
  color: #fff !important;
  background: #4a6cf7 !important;
  font-weight: 600;
}

.btn-primary {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #4a6cf7;
  color: #fff;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  margin: 0;
}

.empty {
  text-align: center;
  color: #b0bccc;
  padding: 64rpx;
  font-size: 28rpx;
}

.guardian-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
  display: flex;
  gap: 20rpx;
  align-items: flex-start;
  flex-wrap: wrap;
}

.g-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #eef0ff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  color: #4a6cf7;
  font-weight: 700;
  flex-shrink: 0;
}

.g-info {
  flex: 1;
  min-width: 200rpx;
}

.g-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a2340;
  margin-bottom: 8rpx;
}

.g-rel {
  font-size: 24rpx;
  color: #8a9bbf;
  font-weight: 400;
  margin-left: 8rpx;
}

.g-detail {
  font-size: 24rpx;
  color: #8a9bbf;
  margin-bottom: 4rpx;
}

.g-time {
  font-size: 22rpx;
  color: #c0c8d8;
  margin-top: 6rpx;
}

.g-actions {
  width: 100%;
  display: flex;
  gap: 12rpx;
  margin-top: 4rpx;
}

.btn-sm {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  font-size: 24rpx;
  border-radius: 12rpx;
  background: #f4f6fb;
  color: #4a6cf7;
  border: 1.5rpx solid #dde2f0;
  margin: 0;
  padding: 0;
}

.btn-warn {
  color: #f59e0b;
  border-color: #fde68a;
  background: #fffbeb;
}

.btn-danger {
  color: #ef4444;
  border-color: #fecaca;
  background: #fff5f5;
}
