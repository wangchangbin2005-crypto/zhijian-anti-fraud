page { background: #f0f0fa; }

.learn-page { padding-bottom: 60rpx; }

/* 英雄区 */
.learn-hero {
  background: linear-gradient(145deg, #3a5ce5, #7c3aed);
  padding: 48rpx 32rpx 0;
  border-radius: 0 0 40rpx 40rpx;
  margin-bottom: 24rpx;
}

.lh-title {
  font-size: 42rpx;
  font-weight: 800;
  color: #fff;
  letter-spacing: 2rpx;
}

.lh-sub {
  font-size: 24rpx;
  color: rgba(255,255,255,0.7);
  margin-top: 8rpx;
  margin-bottom: 32rpx;
}

.lh-tabs {
  display: flex;
  gap: 0;
}

.lh-tab {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 26rpx;
  color: rgba(255,255,255,0.6);
  border-bottom: 4rpx solid transparent;
  font-weight: 500;
}

.lh-tab.active {
  color: #fff;
  border-bottom-color: #fff;
  font-weight: 700;
}

/* 面板 */
.panel { padding: 0 28rpx; }

/* 搜索 */
.search-row { margin-bottom: 16rpx; }

.search-box {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 16rpx;
  padding: 0 20rpx;
  height: 80rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}

.si { font-size: 28rpx; margin-right: 12rpx; }

.si-input {
  flex: 1;
  font-size: 26rpx;
  color: #1a2340;
}

/* 分类 */
.cat-scroll { margin-bottom: 16rpx; }

.cat-row {
  display: flex;
  gap: 12rpx;
  white-space: nowrap;
  padding: 4rpx 0;
}

.cat-chip {
  display: inline-block;
  padding: 12rpx 28rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: #8a9bbf;
  background: #fff;
  border: 1.5rpx solid #eef0f6;
  flex-shrink: 0;
}

.cat-chip.on {
  background: #4a6cf7;
  color: #fff;
  border-color: #4a6cf7;
}

.count-line {
  font-size: 22rpx;
  color: #b0bccc;
  margin-bottom: 16rpx;
}

.empty-tip {
  text-align: center;
  color: #b0bccc;
  padding: 60rpx;
  font-size: 26rpx;
}

/* 视频卡片 */
.vcard {
  background: #fff;
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.vcard-cover {
  height: 220rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.vcard-play {
  font-size: 64rpx;
  color: rgba(255,255,255,0.9);
}

.vcard-meta {
  position: absolute;
  bottom: 16rpx;
  left: 16rpx;
  right: 16rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.vcard-source {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  font-weight: 700;
  color: #fff;
}

.vcard-source.bili { background: #fb7299; }
.vcard-source.link { background: #4a6cf7; }

.vcard-dur {
  font-size: 20rpx;
  background: rgba(0,0,0,0.5);
  color: #fff;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.vcard-body { padding: 20rpx; }

.vcard-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #1a2340;
  margin-bottom: 8rpx;
}

.vcard-sub {
  display: block;
  font-size: 22rpx;
  color: #8a9bbf;
  margin-bottom: 12rpx;
}

.vcard-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 8rpx;
}

.vcard-author {
  font-size: 22rpx;
  color: #8a9bbf;
}

.vcard-tags { display: flex; gap: 8rpx; flex-wrap: wrap; }

.vtag {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  background: #eef0ff;
  color: #4a6cf7;
  border-radius: 10rpx;
}

/* 文本案例 */
.case-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}

.case-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 10rpx;
}

.case-lv {
  font-size: 20rpx;
  font-weight: 600;
  padding: 4rpx 14rpx;
  border-radius: 10rpx;
  border: 1.5rpx solid;
  flex-shrink: 0;
}

.case-title {
  flex: 1;
  font-size: 28rpx;
  font-weight: 600;
  color: #1a2340;
  display: block;
}

.case-arrow {
  font-size: 24rpx;
  color: #b0bccc;
  flex-shrink: 0;
}

.case-summary {
  font-size: 24rpx;
  color: #8a9bbf;
  line-height: 1.6;
  display: block;
}

.case-detail {
  font-size: 26rpx;
  color: #2d3748;
  line-height: 1.7;
  display: block;
  margin-top: 16rpx;
}

.case-block {
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-top: 12rpx;
}

.case-block.red { background: #fff5f5; }
.case-block.green { background: #f0fdf4; }

.cb-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #1a2340;
  display: block;
  margin-bottom: 8rpx;
}

.cb-li {
  font-size: 22rpx;
  color: #4a5568;
  line-height: 1.8;
  display: block;
}

/* 图解 */
.img-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.img-card {
  border-radius: 20rpx;
  padding: 24rpx 16rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-height: 220rpx;
}

.img-tag {
  font-size: 20rpx;
  background: rgba(255,255,255,0.25);
  color: #fff;
  padding: 4rpx 14rpx;
  border-radius: 10rpx;
  align-self: flex-start;
}

.img-em { font-size: 52rpx; text-align: center; margin: 12rpx 0; }

.img-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #fff;
  display: block;
}

.img-desc {
  font-size: 20rpx;
  color: rgba(255,255,255,0.75);
  display: block;
  margin-top: 4rpx;
}

/* 测验 */
.quiz-panel {}

.quiz-start {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
  gap: 16rpx;
}

.qs-em { font-size: 80rpx; }

.qs-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1a2340;
}

.qs-sub {
  font-size: 24rpx;
  color: #8a9bbf;
}

.qs-btn {
  background: linear-gradient(135deg, #4a6cf7, #7c3aed);
  color: #fff;
  border-radius: 16rpx;
  border: none;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 28rpx;
  font-weight: 600;
  padding: 0 60rpx;
  margin-top: 16rpx;
  box-shadow: 0 4rpx 20rpx rgba(74,108,247,0.3);
}

.quiz-result {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0 40rpx;
  gap: 12rpx;
}

.qr-score {
  font-size: 80rpx;
  font-weight: 800;
  color: #4a6cf7;
}

.qr-total {
  font-size: 40rpx;
  color: #8a9bbf;
}

.qr-label {
  font-size: 32rpx;
  color: #1a2340;
  font-weight: 600;
}

.quiz-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.qprog-bar {
  height: 8rpx;
  background: #eef0f6;
  border-radius: 4rpx;
  margin-bottom: 12rpx;
  overflow: hidden;
}

.qprog-fill {
  height: 100%;
  background: linear-gradient(90deg, #4a6cf7, #7c3aed);
  border-radius: 4rpx;
  transition: width 0.3s;
}

.qprog-text {
  font-size: 22rpx;
  color: #8a9bbf;
  display: block;
  margin-bottom: 24rpx;
}

.qq-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a2340;
  line-height: 1.6;
  display: block;
  margin-bottom: 28rpx;
}

.qopt {
  width: 100%;
  background: #f8f8ff;
  color: #1a2340;
  border: 1.5rpx solid #eef0f6;
  border-radius: 14rpx;
  font-size: 26rpx;
  height: 88rpx;
  line-height: 88rpx;
  margin-bottom: 14rpx;
  text-align: left;
  padding: 0 24rpx;
}

.qopt.ok { background: #dcfce7; color: #16a34a; border-color: #86efac; }
.qopt.bad { background: #fee2e2; color: #dc2626; border-color: #fca5a5; }

.qexp {
  font-size: 24rpx;
  color: #8a9bbf;
  line-height: 1.6;
  display: block;
  margin: 16rpx 0 24rpx;
}

.qa-ans { font-size: 26rpx; color: #16a34a; display: block; margin: 10rpx 0 6rpx; }
.qa-exp { font-size: 22rpx; color: #8a9bbf; display: block; }

/* 弹窗 */
.modal-mask {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: flex-end;
  z-index: 999;
}

.modal-box {
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 40rpx 32rpx calc(40rpx + env(safe-area-inset-bottom));
  width: 100%;
  max-height: 70vh;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a2340;
  display: block;
  margin-bottom: 20rpx;
}

.modal-body { max-height: 50vh; margin-bottom: 24rpx; }

.ml { font-size: 24rpx; color: #4a5568; line-height: 1.8; display: block; }
.mw { font-size: 24rpx; color: #dc2626; display: block; margin: 12rpx 0; }
.md { font-size: 24rpx; color: #4a5568; line-height: 1.7; display: block; }

.modal-close {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #f4f6fb;
  color: #4a6cf7;
  border-radius: 16rpx;
  font-size: 28rpx;
  border: none;
  margin: 0;
}

/* 视频封面优化 */
.vcard-overlay {
  position: absolute;
  inset: 0;
  background: rgba(0,0,0,0.2);
}

.vcard-play-btn {
  width: 96rpx;
  height: 96rpx;
  background: rgba(255,255,255,0.25);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(4px);
  z-index: 1;
}

.vcard-play-icon {
  font-size: 36rpx;
  color: #fff;
  margin-left: 6rpx;
}

.vcard-cat-tag {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  background: rgba(255,255,255,0.2);
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  border-radius: 10rpx;
  backdrop-filter: blur(4px);
  z-index: 1;
}

/* 图解横向滑动 */
.img-hint {
  font-size: 22rpx;
  color: #b0bccc;
  margin-bottom: 16rpx;
  text-align: center;
}

.img-scroll { margin-bottom: 24rpx; }

.img-row {
  display: flex;
  gap: 16rpx;
  white-space: nowrap;
  padding: 8rpx 0;
}

.img-card {
  display: inline-flex;
  flex-direction: column;
  justify-content: space-between;
  width: 280rpx;
  min-height: 320rpx;
  border-radius: 24rpx;
  padding: 24rpx 20rpx;
  flex-shrink: 0;
  white-space: normal;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.15);
}

.img-tap-hint {
  font-size: 20rpx;
  color: rgba(255,255,255,0.6);
  margin-top: 12rpx;
}

.img-list { display: flex; flex-direction: column; gap: 12rpx; }

.img-list-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
}

.ili-dot {
  width: 12rpx;
  height: 48rpx;
  border-radius: 6rpx;
  flex-shrink: 0;
}

.ili-info { flex: 1; }

.ili-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #1a2340;
}

.ili-desc {
  display: block;
  font-size: 22rpx;
  color: #8a9bbf;
  margin-top: 4rpx;
}

.ili-em { font-size: 40rpx; flex-shrink: 0; }

/* 测验退出按钮 */
.quiz-top-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.quit-btn {
  background: #fff0f0;
  color: #ef4444;
  border: 1.5rpx solid #fecaca;
  border-radius: 12rpx;
  font-size: 22rpx;
  height: 60rpx;
  line-height: 60rpx;
  padding: 0 20rpx;
  margin: 0;
}

/* 视频封面装饰 */
.vcard-cover {
  height: 220rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
}

.vcard-pattern {
  position: absolute;
  inset: 0;
  background-image: radial-gradient(circle at 20% 80%, rgba(255,255,255,0.08) 0%, transparent 50%),
    radial-gradient(circle at 80% 20%, rgba(255,255,255,0.08) 0%, transparent 50%);
}

.vcard-center {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  z-index: 1;
}

.vcard-type-icon { font-size: 40rpx; }

.vcard-play-btn {
  font-size: 48rpx;
  color: rgba(255,255,255,0.9);
  background: rgba(255,255,255,0.2);
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 图解列表样式 */
.img-list-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}

.img-list-left {
  width: 100rpx;
  height: 100rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.img-list-em { font-size: 48rpx; }

.img-list-info { flex: 1; min-width: 0; }

.img-list-top { margin-bottom: 8rpx; }

.img-list-tag {
  font-size: 20rpx;
  padding: 4rpx 14rpx;
  background: #eef0ff;
  color: #4a6cf7;
  border-radius: 10rpx;
}

.img-list-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #1a2340;
  margin-bottom: 6rpx;
}

.img-list-desc {
  display: block;
  font-size: 22rpx;
  color: #8a9bbf;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.img-list-arrow {
  font-size: 40rpx;
  color: #c0c8d8;
  flex-shrink: 0;
}

/* 测验顶部栏 */
.quiz-top-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.quit-btn {
  background: #fff0f0;
  color: #ef4444;
  border: 1.5rpx solid #fecaca;
  border-radius: 12rpx;
  font-size: 24rpx;
  height: 60rpx;
  line-height: 60rpx;
  padding: 0 24rpx;
  margin: 0;
}
