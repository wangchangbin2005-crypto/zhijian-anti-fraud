<view class="learn-page">

  <view class="learn-hero">
    <view class="lh-title">反诈学习中心</view>
    <view class="lh-sub">精选内容 · 提升防骗意识</view>
    <view class="lh-tabs">
      <view wx:for="{{mainTabs}}" wx:key="id"
        class="lh-tab {{tab===item.id?'active':''}}"
        data-t="{{item.id}}" bindtap="setTab">{{item.name}}</view>
    </view>
  </view>

  <!-- 精选案例 -->
  <view wx:if="{{tab==='hall'}}" class="panel">
    <view class="search-row">
      <view class="search-box">
        <text class="si">🔍</text>
        <input class="si-input" value="{{hallSearch}}" placeholder="搜索内容…" bindinput="onHallSearch" bindconfirm="onHallSearchConfirm" />
      </view>
    </view>
    <scroll-view scroll-x class="cat-scroll" show-scrollbar="{{false}}">
      <view class="cat-row">
        <view wx:for="{{hallCategories}}" wx:key="id"
          class="cat-chip {{hallCat===item.id?'on':''}}"
          data-id="{{item.id}}" bindtap="pickHallCat">{{item.name}}</view>
      </view>
    </scroll-view>
    <view class="count-line">共 {{hallFiltered.length}} 条内容</view>
    <view wx:if="{{!hallFiltered.length}}" class="empty-tip">无匹配内容</view>
    <view wx:for="{{hallFiltered}}" wx:key="id" class="vcard"
      data-url="{{item.url}}" data-kind="{{item.kind}}" bindtap="openHallItem">
      <view class="vcard-cover" style="background:linear-gradient(150deg,{{item.bg1}},{{item.bg2}})">
        <view class="vcard-pattern"></view>
        <view class="vcard-center">
          <text class="vcard-type-icon">{{item.kind==='bilibili'?'📺':'📰'}}</text>
          <view class="vcard-play-btn">▶</view>
        </view>
        <view class="vcard-meta">
          <text class="vcard-source {{item.kind==='bilibili'?'bili':'link'}}">{{item.kind==='bilibili'?'B站':'资讯'}}</text>
          <text class="vcard-dur" wx:if="{{item.duration}}">{{item.duration}}</text>
        </view>
      </view>
      <view class="vcard-body">
        <text class="vcard-title">{{item.title}}</text>
        <text class="vcard-sub">{{item.subtitle}}</text>
        <view class="vcard-foot">
          <text class="vcard-author">{{item.author}}</text>
          <view class="vcard-tags">
            <text wx:for="{{item.tags}}" wx:for-item="tg" wx:key="*this" class="vtag">{{tg}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 文本案例 -->
  <view wx:if="{{tab==='text'}}" class="panel">
    <scroll-view scroll-x class="cat-scroll" show-scrollbar="{{false}}">
      <view class="cat-row">
        <view wx:for="{{categories}}" wx:key="id"
          class="cat-chip {{activeCat===item.id?'on':''}}"
          data-id="{{item.id}}" bindtap="onCat">{{item.icon}}{{item.name}}</view>
      </view>
    </scroll-view>
    <view wx:for="{{filtered}}" wx:key="title" class="case-card" data-i="{{index}}" bindtap="toggleCase">
      <view class="case-head">
        <text class="case-lv" style="color:{{item.levelColor}};border-color:{{item.levelColor}}">{{item.level}}</text>
        <text class="case-title">{{item.title}}</text>
        <text class="case-arrow">{{openIdx===index?'∧':'∨'}}</text>
      </view>
      <text class="case-summary">{{item.summary}}</text>
      <block wx:if="{{openIdx===index}}">
        <text class="case-detail">{{item.detail}}</text>
        <view class="case-block red">
          <text class="cb-title">⚠️ 识别要点</text>
          <text wx:for="{{item.tips}}" wx:for-item="tip" wx:key="*this" class="cb-li">• {{tip}}</text>
        </view>
        <view class="case-block green">
          <text class="cb-title">✅ 正确应对</text>
          <text wx:for="{{item.actions}}" wx:for-item="ac" wx:key="*this" class="cb-li">• {{ac}}</text>
        </view>
      </block>
    </view>
  </view>

  <!-- 图解识骗 - 改为列表样式 -->
  <view wx:if="{{tab==='image'}}" class="panel">
    <view wx:for="{{imageCards}}" wx:key="id" class="img-list-card"
      data-i="{{index}}" bindtap="openImg">
      <view class="img-list-left" style="background:linear-gradient(135deg,{{item.bg1}},{{item.bg2}})">
        <text class="img-list-em">{{item.emoji}}</text>
      </view>
      <view class="img-list-info">
        <view class="img-list-top">
          <text class="img-list-tag">{{item.tag}}</text>
        </view>
        <text class="img-list-title">{{item.title}}</text>
        <text class="img-list-desc">{{item.desc}}</text>
      </view>
      <text class="img-list-arrow">›</text>
    </view>
  </view>

  <!-- 防骗测验 -->
  <view wx:if="{{tab==='quiz'}}" class="panel quiz-panel">
    <block wx:if="{{!quizStarted}}">
      <view class="quiz-start">
        <text class="qs-em">🧩</text>
        <text class="qs-title">防骗能力测试</text>
        <text class="qs-sub">共 {{quiz.length}} 题，测测你的防骗指数</text>
        <button class="qs-btn" bindtap="startQuiz">开始测试</button>
      </view>
    </block>
    <block wx:elif="{{quizDone}}">
      <view class="quiz-result">
        <text class="qr-score">{{qScore}}<text class="qr-total">/{{quiz.length}}</text></text>
        <text class="qr-label">{{qScore>=quiz.length*0.8?'防骗达人🎉':qScore>=quiz.length*0.5?'继续加油💪':'需要学习📚'}}</text>
        <button class="qs-btn" bindtap="startQuiz">再测一次</button>
      </view>
      <view wx:for="{{quiz}}" wx:for-index="qi" wx:key="qi" class="case-card">
        <text class="case-title">{{qi+1}}. {{item.q}}</text>
        <text class="qa-ans">答案：{{item.options[item.answer]}}</text>
        <text class="qa-exp">{{item.explain}}</text>
      </view>
    </block>
    <block wx:else>
      <view class="quiz-card" wx:if="{{currentQuiz}}">
        <view class="quiz-top-bar">
          <text class="qprog-text">{{qIdx+1}} / {{quiz.length}}</text>
          <button class="quit-btn" bindtap="quitQuiz">退出测试</button>
        </view>
        <view class="qprog-bar">
          <view class="qprog-fill" style="width:{{(qIdx+1)/quiz.length*100}}%"></view>
        </view>
        <text class="qq-text">{{currentQuiz.q}}</text>
        <button wx:for="{{currentQuiz.options}}" wx:for-item="opt" wx:key="*this" wx:for-index="oi"
          class="qopt {{qAnswered?(oi===currentQuiz.answer?'ok':(oi===userPickForCurrent?'bad':'')):''}} "
          disabled="{{qAnswered}}" data-i="{{oi}}" bindtap="pickAns">{{opt}}</button>
        <text wx:if="{{qAnswered}}" class="qexp">{{currentQuiz.explain}}</text>
        <button wx:if="{{qAnswered}}" class="qs-btn" bindtap="nextQ">{{qIdx<quiz.length-1?'下一题':'查看结果'}}</button>
      </view>
    </block>
  </view>

</view>

<view class="modal-mask" wx:if="{{modal}}" catchtouchmove="noop" bindtap="closeModal">
  <view class="modal-box" catchtap="noop">
    <text class="modal-title">{{modal.title}}</text>
    <scroll-view scroll-y class="modal-body">
      <text wx:for="{{modal.mockLines}}" wx:key="*this" class="ml">{{item}}</text>
      <text class="mw">⚠️ {{modal.warning}}</text>
      <text class="md">{{modal.fullDesc}}</text>
      <text wx:for="{{modal.steps}}" wx:key="*this" class="ml">• {{item}}</text>
    </scroll-view>
    <button class="modal-close" bindtap="closeModal">关闭</button>
  </view>
</view>
