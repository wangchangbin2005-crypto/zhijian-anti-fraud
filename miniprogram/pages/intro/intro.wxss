.intro-page {
  position: fixed;
  inset: 0;
  background: #060c18;
  z-index: 100;
}

.skip {
  position: absolute;
  top: calc(24rpx + env(safe-area-inset-top));
  right: 32rpx;
  z-index: 10;
  padding: 12rpx 28rpx;
  color: rgba(255, 255, 255, 0.5);
  font-size: 24rpx;
  border: 1px solid rgba(255, 255, 255, 0.12);
  border-radius: 10rpx;
}

.fs-card {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 48rpx;
  box-sizing: border-box;
}

.fs-counter {
  position: absolute;
  top: calc(80rpx + env(safe-area-inset-top));
  right: 40rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.35);
}

.progress {
  position: absolute;
  bottom: 0;
  left: 0;
  height: 6rpx;
  background: linear-gradient(90deg, #3b82f6, #06b6d4);
}

.fs-lock {
  font-size: 120rpx;
  margin-bottom: 32rpx;
}

.fs-tag {
  font-size: 22rpx;
  color: rgba(59, 130, 246, 0.65);
  letter-spacing: 4rpx;
  margin-bottom: 16rpx;
}

.fs-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  text-align: center;
}

.fs-hint {
  margin-top: 48rpx;
  color: #6b82a8;
  font-size: 28rpx;
}

.fs-emoji {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.fs-btitle {
  font-size: 44rpx;
  font-weight: 800;
  color: #fff;
  text-align: center;
  margin-bottom: 20rpx;
}

.fs-desc {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.55);
  text-align: center;
  line-height: 1.75;
  margin-bottom: 32rpx;
}

.fs-warn {
  padding: 20rpx 28rpx;
  border-radius: 16rpx;
  background: rgba(239, 68, 68, 0.15);
  border: 1px solid rgba(239, 68, 68, 0.35);
  color: #fca5a5;
  font-size: 26rpx;
  margin-bottom: 40rpx;
}

.fs-next {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.35);
}

.unlock {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
}

.big {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}

.ut {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  text-align: center;
}

.us {
  font-size: 24rpx;
  color: #6b82a8;
  margin: 16rpx 0 48rpx;
}

.ubtn {
  background: linear-gradient(135deg, #1d4ed8, #3b82f6);
  color: #fff;
  padding: 24rpx 80rpx;
  border-radius: 20rpx;
  font-size: 30rpx;
  border: none;
}
