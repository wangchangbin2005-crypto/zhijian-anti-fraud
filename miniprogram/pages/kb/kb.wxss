.full {
  width: 100%;
}

.mt {
  margin-top: 16rpx;
}

.sr {
  border: 1px solid var(--border);
  border-radius: 12rpx;
  padding: 16rpx;
  margin-top: 12rpx;
}

.srh {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.tp {
  font-size: 22rpx;
  font-weight: 600;
}

.sim {
  font-size: 28rpx;
  font-weight: 700;
  color: #3b82f6;
}

.su {
  font-size: 24rpx;
  color: #6b82a8;
}

.clist {
  max-height: 480rpx;
  margin-top: 16rpx;
}

.ci {
  padding: 16rpx 0;
  border-bottom: 1px solid var(--border);
}

.tp2 {
  display: inline-block;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  border: 1px solid;
  margin-bottom: 8rpx;
}

.cs {
  display: block;
  font-size: 24rpx;
  color: #e2eaf8;
  line-height: 1.55;
}

.ck {
  font-size: 22rpx;
  color: #3d5278;
  margin-top: 6rpx;
  display: block;
}

.modal {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.85);
  z-index: 1000;
  display: flex;
  align-items: stretch;
  justify-content: center;
  padding: 40rpx 24rpx;
}

.tree-panel {
  background: #111e30;
  border: 1px solid var(--border2);
  border-radius: 20rpx;
  width: 100%;
  max-width: 700rpx;
  display: flex;
  flex-direction: column;
  max-height: 85vh;
}

.tree-head {
  display: flex;
  justify-content: space-between;
  padding: 24rpx;
  border-bottom: 1px solid var(--border);
}

.th {
  font-size: 30rpx;
  font-weight: 700;
  color: #fff;
}

.tx {
  color: #93c5fd;
  font-size: 26rpx;
}

.tree-scroll {
  max-height: 280rpx;
  padding: 12rpx;
}

.br {
  display: flex;
  justify-content: space-between;
  padding: 20rpx;
  margin-bottom: 10rpx;
  background: rgba(6, 11, 22, 0.5);
  border-radius: 10rpx;
  font-size: 26rpx;
  color: #e2eaf8;
}

.bc {
  color: #6b82a8;
  font-size: 24rpx;
}

.tree-detail {
  flex: 1;
  padding: 16rpx 24rpx;
  border-top: 1px solid var(--border);
  max-height: 360rpx;
}

.tts {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #93c5fd;
  margin-bottom: 12rpx;
}

.tci {
  padding: 12rpx 0;
  border-bottom: 1px solid var(--border);
  font-size: 24rpx;
  line-height: 1.5;
}

.tk {
  font-size: 22rpx;
  color: #3d5278;
  display: block;
  margin-top: 6rpx;
}
