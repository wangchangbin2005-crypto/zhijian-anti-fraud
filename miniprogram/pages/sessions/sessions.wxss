.toolbar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
  flex-wrap: wrap;
}

.pick {
  padding: 12rpx 24rpx;
  background: #192840;
  border: 1px solid var(--border);
  border-radius: 10rpx;
  font-size: 24rpx;
}

.sm {
  font-size: 22rpx;
  padding: 12rpx 20rpx;
  margin: 0;
}

.sm.danger {
  color: #f87171;
  border-color: rgba(239, 68, 68, 0.35);
}

.layout {
  display: flex;
  gap: 16rpx;
  height: 480rpx;
  margin-bottom: 24rpx;
}

.list, .detail {
  flex: 1;
  background: #142236;
  border: 1px solid var(--border);
  border-radius: 12rpx;
  padding: 12rpx;
  box-sizing: border-box;
}

.sess {
  padding: 16rpx;
  border-bottom: 1px solid var(--border);
  border-radius: 8rpx;
  margin-bottom: 8rpx;
}

.sess.on {
  background: rgba(59, 130, 246, 0.1);
  border: 1px solid rgba(59, 130, 246, 0.3);
}

.r1 {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 8rpx;
}

.c {
  margin-left: auto;
  font-size: 22rpx;
  color: #6b82a8;
}

.del {
  font-size: 24rpx;
  padding: 0 8rpx;
}

.id {
  font-size: 18rpx;
  color: #3d5278;
  word-break: break-all;
}

.t {
  font-size: 20rpx;
  color: #6b82a8;
}

.msg {
  padding: 16rpx 0;
  border-bottom: 1px solid var(--border);
}

.mh {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 22rpx;
  margin-bottom: 8rpx;
}

.ts {
  margin-left: auto;
  font-size: 20rpx;
  color: #3d5278;
}

.mc {
  font-size: 24rpx;
  line-height: 1.6;
}

.ft {
  font-size: 22rpx;
  color: #6b82a8;
  margin-top: 6rpx;
  display: block;
}

.empty {
  text-align: center;
  color: #6b82a8;
  padding: 40rpx;
  font-size: 24rpx;
}

.risk-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 10rpx;
}

.cn {
  color: var(--blue);
  font-weight: 600;
}

.rh {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 10rpx;
  font-size: 22rpx;
}

.ft2 {
  flex: 1;
  color: #6b82a8;
}
