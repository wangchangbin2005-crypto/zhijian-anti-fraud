.aria-wrap {
  position: fixed;
  right: 24rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  z-index: 9999;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}

.aria-bubble {
  position: absolute;
  right: 0;
  bottom: 120rpx;
  max-width: 360rpx;
  padding: 20rpx 24rpx;
  background: rgba(10, 18, 38, 0.97);
  border: 1px solid rgba(59, 130, 246, 0.45);
  border-radius: 24rpx 24rpx 8rpx 24rpx;
  font-size: 24rpx;
  color: #e2e8f0;
  line-height: 1.65;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.5);
}

.aria-figure {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #1d4ed8, #3b82f6);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 52rpx;
  box-shadow: 0 8rpx 24rpx rgba(59, 130, 246, 0.45);
  animation: ariaFloat 3s ease-in-out infinite;
}

.aria-figure.alert {
  background: linear-gradient(135deg, #b91c1c, #ef4444);
  animation: ariaShake 0.35s ease-in-out infinite alternate;
  box-shadow: 0 8rpx 28rpx rgba(239, 68, 68, 0.55);
}

.aria-figure.happy {
  background: linear-gradient(135deg, #15803d, #22c55e);
  animation: ariaHop 1s ease-in-out infinite alternate;
  box-shadow: 0 8rpx 24rpx rgba(34, 197, 94, 0.45);
}

@keyframes ariaFloat {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-12rpx); }
}

@keyframes ariaShake {
  0% { transform: rotate(-4deg) scale(1.02); }
  100% { transform: rotate(4deg) scale(1.06); }
}

@keyframes ariaHop {
  0% { transform: translateY(0); }
  100% { transform: translateY(-14rpx); }
}

.aria-label {
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  color: rgba(147, 197, 253, 0.9);
}

.aria-status {
  font-size: 18rpx;
  color: rgba(148, 163, 184, 0.75);
}
